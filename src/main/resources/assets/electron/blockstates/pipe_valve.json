{
  "multipart": [
    {
      "apply": {
        "model": "electron:block/pipe_valve_core"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "electron:block/pipe_valve_down"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "electron:block/pipe_valve_up"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "electron:block/pipe_valve_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "electron:block/pipe_valve_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "electron:block/pipe_valve_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "electron:block/pipe_valve_east"
      }
    }
  ]
}
